# TR-DB-014: the profile and the database file are selected by configuration
# alone. No code change, no conditional compilation, no separate build artifact.

# ---- local preview profile (§8.4) -------------------------------------------
APP_PROFILE=local-preview
SQLITE_FILE=./data/sddfreak.db

# ---- deployed profile --------------------------------------------------------
# Same engine (CON-004), same image; a deployed installation is one that holds
# data anyone cares about, and is held to §8.4.3 in full.
# APP_PROFILE=deployed
# SQLITE_FILE=/var/lib/sddfreak/sddfreak.db

PORT=3000
HOST=0.0.0.0

# Signs session cookies. Generate with: openssl rand -hex 32
# The local preview falls back to a fixed development value; the deployed
# profile refuses to start without a real one.
SESSION_SECRET=

# Origin allowed to call the API with credentials (the frontend).
CORS_ORIGIN=http://localhost:5173
